# BioChem Lab environment variables
# Copy this file to .env for local development, and add the same keys
# in your Vercel/Netlify project settings for production.

# Supabase — Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: AI Tutor mode (Formula Studio -> Settings)
# Any OpenAI-compatible endpoint works. The key is stored ONLY in your
# browser's localStorage and is sent directly from your browser to the
# endpoint you configure. Leave blank to use the built-in offline engine.
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4o-mini
